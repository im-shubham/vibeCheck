# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (server-only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: video testimonials via Cloudflare R2 / AWS S3 (signed PUT uploads) ---
# Leave blank to disable video; text testimonials keep working.
# R2:  S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   S3_REGION=auto
# S3:  leave S3_ENDPOINT blank and set S3_REGION (e.g. us-east-1)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket (R2 public bucket / custom domain / CloudFront), no trailing slash
S3_PUBLIC_URL=
